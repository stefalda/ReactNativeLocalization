{
  "name": "react-native-localization",
  "version": "3.0.0",
  "description": "Simple module to localize the React Native interface",
  "source": "src/index.ts",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "windows",
    "ReactNativeLocalization.podspec",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:commonjs && npm run build:module",
    "build:commonjs": "tsc -p tsconfig.build.json",
    "build:module": "tsc -p tsconfig.module.json",
    "clean": "rimraf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stefalda/ReactNativeLocalization.git"
  },
  "keywords": [
    "localization",
    "internationalization",
    "javascript",
    "typescript",
    "ios",
    "android",
    "react",
    "react-native",
    "react-component"
  ],
  "author": "Stefano Falda <stefano.falda@gmail.com> (http://www.babisoft.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stefalda/ReactNativeLocalization/issues"
  },
  "homepage": "https://github.com/stefalda/ReactNativeLocalization",
  "dependencies": {
    "react-localization": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.73.0",
    "react-native-windows": ">=0.73.0"
  },
  "peerDependenciesMeta": {
    "react-native-windows": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
